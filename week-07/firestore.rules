rules_version = '2';

// 동네 맛집 평점판 보안 규칙
// 붙여 넣는 곳: Firebase 콘솔 → Firestore Database → 규칙 → 이 파일 내용으로 바꾸고 [게시]
//
// 기본 약속
//   읽기: 누구나 (로그인 안 해도 가게 평균 · 리뷰 · 댓글을 볼 수 있음)
//   쓰기: 로그인한 사람만, 쓴 사람 칸(uid)은 반드시 내 번호
//   지우기 · 고치기: 내가 쓴 것만
//   나만 봐야 하는 기록(users: 내 별명 · 그림)은 읽기도 나만
// 한 사람은 한 가게에 한 번만 별점을 줘요: 리뷰 문서 이름이 "내uid_가게번호" 여야만 만들 수 있어서
//   같은 가게에 두 번째 리뷰는 만들 수 없고(고치기만 가능), 남의 문서 이름으로는 못 만들어요.
// 한계: 진짜 가게 주인인지는 확인하지 못해요. (먼저 등록한 로그인 사람이 주인)
//       다른 사람이 쓴 댓글 · 좋아요는 리뷰 주인도 못 지워요. (자기 것만 지울 수 있어서) 리뷰가 지워지면 화면에는 안 나와요.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 도우미 ──
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isColor(v) { return v is string && v.matches('^#[0-9a-fA-F]{6}$'); }
    // 쓴 사람 칸: 별명 · 그림 · 색 (Google 이름이나 메일은 들어가지 않음)
    function validAuthor(d) {
      return isStr(d.authorName, 1, 12) && isStr(d.authorEmoji, 1, 8) && isColor(d.authorColor);
    }
    function shopDoc(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function reviewDoc(reviewId) { return /databases/$(database)/documents/reviews/$(reviewId); }
    function commentDoc(commentId) { return /databases/$(database)/documents/comments/$(commentId); }

    // ── 내 별명 · 그림: 나만 읽고 쓰고 지움 ──
    match /users/{userId} {
      allow read: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['nickname', 'emoji', 'color'])
        && request.resource.data.keys().hasAll(['nickname', 'emoji', 'color'])
        && isStr(request.resource.data.nickname, 1, 12)
        && isStr(request.resource.data.emoji, 1, 8)
        && isColor(request.resource.data.color);
      allow delete: if signedIn() && userId == me();
    }

    // ── 가게 주인 등록: 가게 번호가 문서 이름이라 한 가게에 주인은 한 명 ──
    match /shops/{shopId} {
      allow read: if true;
      allow create: if signedIn() && shopId.matches('s-.*')
        && request.resource.data.keys().hasOnly(['name', 'registeredAt', 'ownerUid', 'ownerName', 'ownerEmoji', 'ownerColor'])
        && request.resource.data.keys().hasAll(['name', 'registeredAt', 'ownerUid', 'ownerName', 'ownerEmoji', 'ownerColor'])
        && isStr(request.resource.data.name, 1, 60)
        && request.resource.data.registeredAt is number
        && request.resource.data.ownerUid == me()
        && isStr(request.resource.data.ownerName, 1, 12)
        && isStr(request.resource.data.ownerEmoji, 1, 8)
        && isColor(request.resource.data.ownerColor);
      // 주인은 자기 별명 · 그림이 바뀔 때 그 칸만 고칠 수 있음 (주인 바꾸기 · 가게 이름 바꾸기는 안 됨)
      allow update: if signedIn() && resource.data.ownerUid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName', 'ownerEmoji', 'ownerColor'])
        && isStr(request.resource.data.ownerName, 1, 12)
        && isStr(request.resource.data.ownerEmoji, 1, 8)
        && isColor(request.resource.data.ownerColor);
      allow delete: if signedIn() && resource.data.ownerUid == me();
    }

    // ── 리뷰: 문서 이름 = 내uid_가게번호 → 한 사람은 한 가게에 한 번만 ──
    function validReview(d) {
      return d.keys().hasOnly(['shop', 'shopId', 'menu', 'stars', 'text', 'hasPhoto', 'createdAt', 'editedAt', 'authorUid', 'authorName', 'authorEmoji', 'authorColor'])
        && d.keys().hasAll(['shop', 'shopId', 'menu', 'stars', 'text', 'hasPhoto', 'createdAt', 'authorUid', 'authorName', 'authorEmoji', 'authorColor'])
        && isStr(d.shop, 1, 60)
        && isStr(d.shopId, 3, 700) && d.shopId.matches('s-.*')
        && isStr(d.menu, 1, 60)
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && isStr(d.text, 0, 1000)
        && d.hasPhoto is bool
        && d.createdAt is number
        && (!('editedAt' in d) || d.editedAt is number)
        && validAuthor(d);
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && validReview(request.resource.data)
        && request.resource.data.authorUid == me()
        && reviewId == me() + '_' + request.resource.data.shopId;
      // 고칠 수 있는 건 내 리뷰뿐. 쓴 사람 · 가게 · 쓴 날짜는 못 바꿈
      allow update: if signedIn() && resource.data.authorUid == me()
        && validReview(request.resource.data)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.shop == resource.data.shop
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.authorUid == me();
    }

    // ── 리뷰 사진 (눌렀을 때만 불러오는 별도 문서): 이름이 내uid_ 로 시작해야 만들 수 있음 ──
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if signedIn() && photoId.matches(me() + '_s-.*')
        && request.resource.data.keys().hasOnly(['uid', 'data'])
        && request.resource.data.keys().hasAll(['uid', 'data'])
        && request.resource.data.uid == me()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('data:image/.*');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ── 댓글 (사장님 답글이면 byOwner: true — 진짜 그 가게 주인일 때만 true 로 쓸 수 있음) ──
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reviewId', 'shopId', 'text', 'createdAt', 'byOwner', 'authorUid', 'authorName', 'authorEmoji', 'authorColor'])
        && request.resource.data.keys().hasAll(['reviewId', 'shopId', 'text', 'createdAt', 'byOwner', 'authorUid', 'authorName', 'authorEmoji', 'authorColor'])
        && request.resource.data.authorUid == me()
        && validAuthor(request.resource.data)
        && isStr(request.resource.data.text, 1, 400)
        && request.resource.data.createdAt is number
        && request.resource.data.byOwner is bool
        && exists(reviewDoc(request.resource.data.reviewId))
        && get(reviewDoc(request.resource.data.reviewId)).data.shopId == request.resource.data.shopId
        && request.resource.data.byOwner == (exists(shopDoc(request.resource.data.shopId))
             && get(shopDoc(request.resource.data.shopId)).data.ownerUid == me());
      // 별명 · 그림이 바뀔 때 그 칸만 고칠 수 있음
      allow update: if signedIn() && resource.data.authorUid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName', 'authorEmoji', 'authorColor'])
        && validAuthor(request.resource.data);
      allow delete: if signedIn() && resource.data.authorUid == me();
    }

    // ── 댓글 좋아요/싫어요: 문서 이름 = 댓글번호_내uid → 한 사람이 한 댓글에 한 번. 내 댓글에는 못 누름 ──
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['commentId', 'uid', 'kind'])
        && request.resource.data.keys().hasAll(['commentId', 'uid', 'kind'])
        && request.resource.data.uid == me()
        && request.resource.data.kind in ['like', 'dislike']
        && reactionId == request.resource.data.commentId + '_' + me()
        && exists(commentDoc(request.resource.data.commentId))
        && get(commentDoc(request.resource.data.commentId)).data.authorUid != me();
      // 좋아요 ↔ 싫어요 바꾸기
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['commentId', 'uid', 'kind'])
        && request.resource.data.uid == me()
        && request.resource.data.commentId == resource.data.commentId
        && request.resource.data.kind in ['like', 'dislike'];
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // 위에 없는 곳은 모두 막힘 (기본)
  }
}
